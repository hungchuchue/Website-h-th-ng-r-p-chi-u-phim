{
  "name": "cinema-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cinema Backend with Express, TypeScript and PostgreSQL.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "swagger": "node --import tsx src/config/swagger.ts",
    "build": "npm run swagger && tsc && node -e \"require('node:fs').copyFileSync('src/config/swagger_output.json', 'dist/src/config/swagger_output.json')\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "cinema:db:migrate": "node --import tsx src/scripts/cinema.migrate.ts up",
    "cinema:db:status": "node --import tsx src/scripts/cinema.migrate.ts status",
    "cinema:create-admin": "node --import tsx src/scripts/cinema.create-admin.ts",
    "cinema:simulate-payment": "node --import tsx src/scripts/cinema.simulate-payment.ts",
    "cinema:openapi": "node --import tsx src/scripts/cinema.export-openapi.ts",
    "cinema:test": "node --import tsx --test tests/cinema/unit/*.test.ts",
    "cinema:test:integration": "node --import tsx --test tests/cinema/integration/*.test.ts"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mssql": "12.7.13",
    "pg": "8.23.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "swagger-autogen": "2.23.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
