{
  "name": "cinema-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cinema Backend with Express, TypeScript and PostgreSQL.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "swagger": "node --import tsx src/config/swagger.ts",
    "build": "npm run swagger && tsc && node -e \"require('node:fs').copyFileSync('src/config/swagger_output.json', 'dist/src/config/swagger_output.json')\"",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "swagger-autogen": "2.23.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
