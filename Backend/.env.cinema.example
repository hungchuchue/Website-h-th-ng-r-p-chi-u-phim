# New Cinema settings; the existing .env is never overwritten by tooling.
# Put these settings into your shell or add them manually to Backend/.env.
CINEMA_ENABLED=false
CINEMA_SQLSERVER_HOST=localhost
CINEMA_SQLSERVER_PORT=1433
CINEMA_SQLSERVER_DATABASE=TroondCinemaDevelopment
CINEMA_SQLSERVER_USER=cinema_application
CINEMA_SQLSERVER_PASSWORD=
CINEMA_SQLSERVER_ENCRYPT=true
# Only opt in for a trusted local development server with a self-signed certificate.
CINEMA_SQLSERVER_TRUST_CERTIFICATE=false
CINEMA_JWT_SECRET=
CINEMA_HOLD_MINUTES=7
CINEMA_WORKERS_ENABLED=true
CINEMA_PUBLIC_URL=http://localhost:3002
CINEMA_PAYMENT_PROVIDER=simulator
CINEMA_SIMULATOR_SECRET=
# Required explicitly for the migration command; no production migration support.
CINEMA_MIGRATION_TARGET=development
# Integration tests REQUIRE a separate database name different from the app database.
CINEMA_TEST_DATABASE=TroondCinema_test
