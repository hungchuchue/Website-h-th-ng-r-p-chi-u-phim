{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "rootDir": "src", "outDir": "dist", "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true, "sourceMap": true
  },
  "files": ["src/index.ts", "src/config/swagger.ts"],
  "include": ["src/**/*.ts"]
}
