# Ưu tiên Backend/.env, sau đó .env ở thư mục gốc; biến shell được ưu tiên.
# Auth admin hiện tại dùng các biến ADMIN_* bên dưới.
ADMIN_EMAIL=admin
# Nhận pbkdf2_sha256$iterations$salt$hash hiện có hoặc hash hex từ npm run auth:create-admin.
# Không điền mật khẩu plaintext.
ADMIN_PASSWORD=replace-with-generated-pbkdf2-sha256-hash
ADMIN_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_JWT_EXPIRES_IN=15m
# Các biến JWT_SECRET / ACCESS_TOKEN_TTL_SECONDS / REFRESH_TOKEN_TTL_SECONDS
# từ bản PostgreSQL trước được giữ để tham khảo; auth admin hiện tại không đọc chúng.
NODE_ENV=development
HOST=localhost
PORT=3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/crash_mobile_tool
DB_REQUIRE_SSL=false
AUTH_DB_SCHEMA=auth_base
# Tạo secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT=30
# false hoặc số hop proxy tin cậy; không bật khi chạy trực tiếp.
TRUST_PROXY=false
# Rỗng cho phép mọi origin; API không dùng cookie. Hoặc danh sách cách bằng dấu phẩy.
CORS_ORIGINS=
LOG_LEVEL=info
# ADMIN_JWT_SECRET / ADMIN_JWT_EXPIRES_IN được dùng trực tiếp cho JWT admin.
# ADMIN_EMAIL / ADMIN_PASSWORD là định danh admin và hash mật khẩu hiện tại; không gửi hash trong request.
